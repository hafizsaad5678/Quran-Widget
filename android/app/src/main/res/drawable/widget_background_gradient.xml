<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFFFFF"
                android:centerColor="#FFF9F0"
                android:endColor="#FFF5E6"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#D4AF37" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Accent Corner -->
    <item
        android:top="0dp"
        android:right="0dp"
        android:width="60dp"
        android:height="60dp"
        android:gravity="top|right">
        <shape android:shape="rectangle">
            <solid android:color="#D4AF37" />
            <corners
                android:topRightRadius="16dp"
                android:bottomLeftRadius="60dp" />
        </shape>
    </item>
</layer-list>
