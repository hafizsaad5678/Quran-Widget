{
  "expo": {
    "name": "quran-daily-ayah",
    "slug": "quran-daily-ayah",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "qurandailyayah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hmzahmza.qurandailyayah"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46945718-6977-4167-ace5-d6f14c465b4a"
      }
    },
    "owner": "hmzahmza"
  }
}
