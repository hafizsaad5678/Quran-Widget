{
  "expo": {
    "name": "Ayah Connect",
    "slug": "quran-daily-ayah",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "qurandailyayah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images.png",
    "splash": {
      "image": "./assets/images.png",
      "resizeMode": "contain",
      "backgroundColor": "#D4AF37"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.qurandaily.ayah"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://qurandailyayah.com",
          "root": "./src/app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46945718-6977-4167-ace5-d6f14c465b4a"
      }
    },
    "owner": "hmzahmza"
  }
}
