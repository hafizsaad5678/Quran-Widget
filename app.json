{
  "expo": {
    "name": "Ayah Connect",
    "slug": "quran-daily-ayah",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "qurandailyayah",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/Quran Widget Logo.png",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.qurandaily.ayah",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Quran Widget Logo.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://qurandailyayah.com",
          "root": "./src/app"
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/Quran Widget Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E6CA72"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used on your device only, to point the compass towards the Qibla."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46945718-6977-4167-ace5-d6f14c465b4a"
      }
    },
    "owner": "hmzahmza",
    "ios": {
      "bundleIdentifier": "com.qurandaily.ayah",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
